# Resend — transactional email for the contact form
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact form enquiries are delivered
CONTACT_EMAIL=your@email.com

# Amar AI chatbot (/api/chat) — runs through an OpenAI-compatible provider:
# OpenRouter or Fireworks. Set the key for whichever you use; if both are set,
# CHAT_PROVIDER (or OpenRouter by default) decides. Without any key the chatbot
# replies with a "not connected" notice.
#
# CHAT_PROVIDER is optional: "openrouter" | "fireworks". Leave blank to
# auto-detect from whichever key is present (OpenRouter wins if both are).
CHAT_PROVIDER=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# Any OpenRouter model slug. Defaults to google/gemini-2.5-flash.
OPENROUTER_MODEL=

# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# Any Fireworks model. Defaults to accounts/fireworks/models/kimi-k2p6.
FIREWORKS_MODEL=

# Upstash Redis — per-IP rate limiting for the chatbot (8/min + 60/day).
# Without these, an in-memory fallback is used (fine for dev, NOT for prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — spam protection for contact form (FREE, unlimited)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_* is exposed to the browser (site key), secret stays server-only.
# Spin canonical names: TURNSTILE_SECRET + TURNSTILE_HOSTNAMES. Legacy TURNSTILE_SECRET_KEY still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxx
TURNSTILE_SECRET=0x4AAAAAAxxxxxxxx_secret
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxx_secret
# Comma-separated frontend hostnames that returned siteverify hostname must match.
# Production must NOT include localhost. Example: amarjeetmishra.com,www.amarjeetmishra.com
TURNSTILE_HOSTNAMES=amarjeetmishra.com,www.amarjeetmishra.com

# PIPE — video pipeline (Cloudflare Worker). Public reads need a read-scope API key.
# Server-only — never use NEXT_PUBLIC for the key.
PIPE_API_URL=http://localhost:8787
PIPE_PUBLIC_API_KEY=pipe_live_xxxxxxxx
